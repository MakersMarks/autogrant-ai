// src/lib/autopilot.ts

export interface ProposalDraft {
  id: string;
  grantId: string;
  grantTitle: string;
  generatedContent: string;
  status: 'draft' | 'submitted';
  createdAt: string;
}

export function generateAutopilotProposal(
  grantId: string,
  grantTitle: string,
  businessProfile: { companyName: string; coreFocus: string },
  writingVoiceSample?: string
): ProposalDraft {
  const sampleVoiceContext = writingVoiceSample 
    ? `Drafted using custom voice profile style.` 
    : `Drafted in standard professional executive tone.`;

  const proposalText = `
# Executive Summary for ${grantTitle}
**Applicant:** ${businessProfile.companyName}
**Core Capability:** ${businessProfile.coreFocus}

## Project Alignment
Our venture directly fulfills the scope of ${grantTitle} by expanding operational output, leveraging verified data analytics, and delivering scalable outcomes.

*Note: ${sampleVoiceContext}*
  `.trim();

  return {
    id: `prop_${Date.now()}`,
    grantId,
    grantTitle,
    generatedContent: proposalText,
    status: 'draft',
    createdAt: new Date().toISOString()
  };
}
