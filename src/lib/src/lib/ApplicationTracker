// src/components/ApplicationTracker.tsx

import React, { useState } from 'react';
import { ProposalDraft } from '../lib/autopilot';

interface ApplicationTrackerProps {
  proposals: ProposalDraft[];
}

export const ApplicationTracker: React.FC<ApplicationTrackerProps> = ({ proposals }) => {
  const [selectedProposal, setSelectedProposal] = useState<ProposalDraft | null>(null);

  return (
    <div className="p-4 bg-slate-900 text-white rounded-lg border border-slate-800">
      <h2 className="text-xl font-bold mb-4">Application Tracker</h2>
      {proposals.length === 0 ? (
        <p className="text-slate-400">No applications saved yet. Swipe or select "Draft with Autopilot" on a grant card.</p>
      ) : (
        <div className="space-y-2">
          {proposals.map((prop) => (
            <div 
              key={prop.id}
              onClick={() => setSelectedProposal(prop)}
              className="p-3 bg-slate-800 hover:bg-slate-700 cursor-pointer rounded flex justify-between items-center"
            >
              <div>
                <p className="font-semibold">{prop.grantTitle}</p>
                <p className="text-xs text-slate-400">Drafted: {new Date(prop.createdAt).toLocaleDateString()}</p>
              </div>
              <span className="px-2 py-1 text-xs rounded bg-blue-600 font-medium uppercase">
                {prop.status}
              </span>
            </div>
          ))}
        </div>
      )}

      {selectedProposal && (
        <div className="mt-6 p-4 bg-slate-950 border border-slate-700 rounded-lg">
          <div className="flex justify-between items-center mb-2">
            <h3 className="font-bold text-lg">{selectedProposal.grantTitle}</h3>
            <button 
              onClick={() => setSelectedProposal(null)}
              className="text-xs px-2 py-1 bg-red-600 rounded"
            >
              Close
            </button>
          </div>
          <pre className="text-sm whitespace-pre-wrap text-slate-300 font-sans">
            {selectedProposal.generatedContent}
          </pre>
        </div>
      )}
    </div>
  );
};
